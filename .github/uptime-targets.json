{
  "targets": [
    {
      "name": "chess",
      "base": "https://chess.sundaysuite.app",
      "samples": 8,
      "timeoutMs": 8000,
      "maxFailRate": 0.1,
      "p95Ms": 2500,
      "paths": [
        { "path": "/", "method": "GET", "expect": [200] },
        { "path": "/", "method": "HEAD", "expect": [200] },
        { "path": "/play", "method": "GET", "expect": [200] },
        {
          "path": "/api/health?db=1",
          "method": "GET",
          "expect": [200, 404],
          "note": "TODO(R1): /api/health does not exist yet, so a not-found 404 is expected too. Tighten expect to [200] once R1 ships the route."
        }
      ]
    }
  ]
}
