# Cloudflare Workers static-assets headers (copied to .open-next/assets).
# The service worker script must always revalidate — a stale sw.js pins users
# to an old app. Next's own headers() entry covers `next start` (e2e).
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
  Content-Type: text/javascript; charset=utf-8
/manifest.webmanifest
  Cache-Control: public, max-age=3600
/icons/*
  Cache-Control: public, max-age=86400
