{
  "name": "sundaychess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:build": "next build",
    "e2e:server": "NODE_ENV=production E2E_SEAM=1 next start -p 3000",
    "e2e:server:worker": "opennextjs-cloudflare build -c wrangler.e2e.jsonc && opennextjs-cloudflare preview -c wrangler.e2e.jsonc -- --port 3000 --var E2E_SEAM:1",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:install:webkit": "playwright install --with-deps webkit",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "chess.js": "^1.4.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
